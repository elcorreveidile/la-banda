# Neon Postgres (cadena pooled; el driver es neon-http, sin transacciones)
DATABASE_URL="postgresql://user:password@host/la_banda?sslmode=require"

# Auth.js — secreto (openssl rand -base64 32). NUNCA pongas AUTH_URL en producción:
# next-auth reescribiría sus URLs a ese origen (trustHost ya resuelve el host real).
AUTH_SECRET=""

# Magic link por la API de Brevo (mismas variables que wp-next-starter)
BREVO_API_KEY="xkeysib-..."
BREVO_SENDER_EMAIL="hola@por2duros.com"
# Solo estos correos pueden entrar (separados por comas)
ALLOWED_EMAILS="javier@blablaele.com"

# Agentes (API de Anthropic)
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-opus-5"
# Esfuerzo de razonamiento por decisión: low | medium | high
ANTHROPIC_EFFORT="medium"

# --- Fase 2: trading simulado ---
# z.ai (proveedor preferido de los agentes; endpoint compatible con el SDK de Anthropic)
ZAI_API_KEY=""
ZAI_MODEL="glm-5.3"
ZAI_BASE_URL="https://api.z.ai/api/anthropic"
# Búsqueda web de z.ai (Denver). Misma clave; 0,01 $ por uso.
ZAI_SEARCH_URL="https://api.z.ai/api/paas/v4/web_search"
# Secreto del cron de Vercel y de la cadena de ticks (openssl rand -hex 32)
CRON_SECRET=""
# Origen público de la app para que los ticks se llamen a sí mismos (en Vercel, la URL de producción)
APP_URL="https://la-banda.vercel.app"

# --- API v1 (la consumen olvidosdegranada.es y por2duros.com desde su servidor) ---
# Authorization: Bearer <clave>  (openssl rand -hex 32)
LA_BANDA_API_KEY=""

# --- Dominio corpus-ele (Clínica Cultural, elcorreveidile/clinica-cultural) ---
# Origen público de la Clínica y la MISMA clave que ella tiene en CLINICA_CORPUS_KEY (Bearer).
# Sin ellas, el dominio corre pero Helsinki no puede registrar nada (herramientas devuelven { error }).
CLINICA_URL="https://www.clinicacultural.com"
CLINICA_CORPUS_KEY=""
# Días que se conserva la traza de sesiones terminadas del corpus (llevan texto de alumnos
# seudonimizado). El cron diario (/api/cron/corpus) purga las más antiguas. Por defecto 30.
CORPUS_TRACE_DAYS="30"
