# Neon Postgres (cadena pooled; el driver es neon-http, sin transacciones)
DATABASE_URL="postgresql://user:password@host/la_banda?sslmode=require"

# Auth.js — secreto (openssl rand -base64 32). NUNCA pongas AUTH_URL en producción:
# next-auth reescribiría sus URLs a ese origen (trustHost ya resuelve el host real).
AUTH_SECRET=""

# Magic link por Resend
AUTH_RESEND_KEY="re_..."
EMAIL_FROM="La Banda <hola@por2duros.com>"
# Solo estos correos pueden entrar (separados por comas)
ALLOWED_EMAILS="javier@blablaele.com"

# Agentes (API de Anthropic)
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-opus-5"
# Esfuerzo de razonamiento por decisión: low | medium | high
ANTHROPIC_EFFORT="medium"
